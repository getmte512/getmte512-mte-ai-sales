# Public browser settings
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only settings — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional until web prospect discovery or conversation intelligence is enabled. Keep the API key server-only.
OPENAI_API_KEY=
PROSPECT_DISCOVERY_MODEL=gpt-5.6-terra
CONVERSATION_INTELLIGENCE_MODEL=gpt-5.6-terra
# Per-user safety/cost guardrails. Positive integers only.
PROSPECT_DISCOVERY_MAX_SEARCHES_PER_DAY=20
PROSPECT_DISCOVERY_MAX_CANDIDATES_PER_DAY=100
PROSPECT_DISCOVERY_COOLDOWN_SECONDS=30

# Optional until approval-gated provider email delivery is enabled.
# Keep provider credentials server-only. Configure the key and verified From address together.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=More Than Energy
# Required before enabling Resend delivery/reply webhooks. Copy the whsec_ value from the Resend webhook endpoint.
RESEND_WEBHOOK_SECRET=

# Set these ISO timestamps only after the named production/pilot verification succeeds.
# Leaving them unset intentionally keeps the Launch Checklist blocked.
LAUNCH_INVITATION_VERIFIED_AT=
LAUNCH_APPROVAL_FLOW_VERIFIED_AT=
LAUNCH_BACKUP_RESTORE_VERIFIED_AT=

# Optional until Shopify synchronization is enabled
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-server-only-shopify-token
SHOPIFY_API_VERSION=2026-01
