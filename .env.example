# Public browser settings
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only settings — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Set these ISO timestamps only after the named production/pilot verification succeeds.
# Leaving them unset intentionally keeps the Launch Checklist blocked.
LAUNCH_INVITATION_VERIFIED_AT=
LAUNCH_APPROVAL_FLOW_VERIFIED_AT=
LAUNCH_BACKUP_RESTORE_VERIFIED_AT=

# Optional until Shopify synchronization is enabled
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-server-only-shopify-token
SHOPIFY_API_VERSION=2026-01
